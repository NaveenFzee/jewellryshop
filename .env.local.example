# ---- Supabase (required) ----
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Only used in admin server actions/routes that need to bypass RLS (e.g. creating the
# first admin_users row). Keep this out of git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Shop identity (all site copy driven from these — see src/lib/config.ts) ----
NEXT_PUBLIC_SHOP_NAME="Your Jewellery Shop Name"
NEXT_PUBLIC_SHOP_TAGLINE="Timeless Elegance, Crafted for You"
NEXT_PUBLIC_SHOP_CITY="Your City"
NEXT_PUBLIC_SHOP_STATE="Your State"
NEXT_PUBLIC_SHOP_ADDRESS="Full store address for maps and structured data"
NEXT_PUBLIC_SHOP_PHONE="+91XXXXXXXXXX"
NEXT_PUBLIC_SHOP_WHATSAPP="91XXXXXXXXXX"
NEXT_PUBLIC_SHOP_EMAIL="hello@yourshop.com"
NEXT_PUBLIC_SITE_URL="https://www.yourshop.com"

# ---- Optional: external gold rate provider ----
# Not called by default — see README "Wiring a live rate provider" section.
# GOLD_RATE_PROVIDER_API_KEY=
# GOLD_RATE_PROVIDER_URL=
